# Optional: defaults are enough for docker compose up --build -d.
# Without a profile: Airflow + dbt. Add --profile source for source Postgres,
# or --profile dwh for the full warehouse including Greenplum.
# SOURCE_PORT is used by source/dwh; GREENPLUM_PORT is used by dwh only.
AIRFLOW_UID=50000
SOURCE_PORT=5051
GREENPLUM_PORT=5433
AIRFLOW_PORT=8080
